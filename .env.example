# ===================================================
# TechNext Academy - Environment Template
# Duplicate this file as .env.local for local development
# ===================================================

# Application URL & Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="TechNext Academy"
NODE_ENV=development

# Support & Contact Channels
NEXT_PUBLIC_SUPPORT_EMAIL=support@technextacademy.com
NEXT_PUBLIC_CONTACT_PHONE=+917812804057
NEXT_PUBLIC_WHATSAPP_NUMBER=+917812804057

# Live Session Configuration
NEXT_PUBLIC_LIVE_SESSION_DATE="2026-09-21"
NEXT_PUBLIC_LIVE_SESSION_FEE="99"

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Authentication & Security
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_minimum_32_characters

# Email Service (Resend / SMTP)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="TechNext Academy <noreply@technextacademy.com>"

# Database / Storage (Optional)
DATABASE_URL=
